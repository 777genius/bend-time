"$BEND" "$PKG/package.bend"
"$BEND" "$PKG/examples/readme.bend"
"$BEND" "$PKG/examples/date.bend"
"$BEND" "$PKG/examples/month.bend"
"$BEND" "$PKG/examples/iso8601.bend"
"$BEND" "$PKG/examples/unix.bend"
"$BEND" "$PKG/examples/duration.bend"
"$BEND" "$PKG/examples/period.bend"
"$BEND" "$PKG/tests/date_test.bend"
"$BEND" "$PKG/tests/duration_test.bend"
"$BEND" "$PKG/tests/period_test.bend"
"$BEND" "$PKG/tests/instant_test.bend"
"$BEND" "$PKG/tests/local_test.bend"
"$BEND" "$PKG/tests/format_test.bend"
"$BEND" "$PKG/tests/week_test.bend"
"$BEND" "$PKG/tests/iso8601_test.bend"

echo "time check ok"
